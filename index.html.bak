        <div data-stagger="1" style="position:relative;background:oklch(0.14 0.015 250);padding:36px;opacity:0;transform:translateY(32px);transition:background 0.3s ease,opacity 0.6s ease,transform 0.6s ease" style-hover="background:oklch(0.17 0.02 250)">
          <div style="position:absolute;top:6px;left:6px;width:8px;height:8px;border-top:1px solid oklch(0.5 0.03 250 / 0.6);border-left:1px solid oklch(0.5 0.03 250 / 0.6)"></div>
          <div style="position:absolute;bottom:6px;right:6px;width:8px;height:8px;border-bottom:1px solid oklch(0.5 0.03 250 / 0.6);border-right:1px solid oklch(0.5 0.03 250 / 0.6)"></div>
          <div style="display:flex;justify-content:space-between;align-items:baseline;font-family:'IBM Plex Mono',monospace;font-size:12px;color:oklch(0.5 0.02 85)"><span>006</span><span>FRC</span></div>
          <img src="assets/proj-frc.jpg" alt="South Bay Robotics  Crescendo" style="width:100%;aspect-ratio:16/10;margin-top:16px;border-radius:4px;object-fit:cover;background:oklch(0.2 0.02 250)">
          <div style="margin-top:20px;font-size:21px;font-weight:500;text-wrap:pretty">South Bay Robotics — “Crescendo”</div>
          <div style="margin-top:8px;display:flex;align-items:center;gap:5px">
            <div style="width:1px;height:5px;background:oklch(0.5 0.03 250 / 0.6)"></div>
