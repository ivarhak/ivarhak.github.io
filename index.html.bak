            <div style="width:36px;height:1px;background:oklch(0.5 0.03 250 / 0.6)"></div>
          </div>
          
          <div style="margin-top:10px;font-size:14px;line-height:1.6;color:oklch(0.72 0.02 85);text-wrap:pretty">A GPS and LoRa capable board powered by battery, communicates with help from&nbsp;external antennas</div><a href="https://github.com/ivarhak/GPSbort" target="_blank" rel="noopener" style="margin-top:14px;display:inline-block;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.08em;color:oklch(0.58 0.14 250);border-bottom:1px solid oklch(0.4 0.03 250 / 0.5)" style-hover="border-color:oklch(0.5 0.14 250)">VIEW ON GITHUB ↗</a>
          <div style="margin-top:16px;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:0.1em;color:oklch(0.45 0.02 85);display:flex;justify-content:space-between;gap:8px"><span>DRWN. IH</span><span>SCALE 1:1</span><span>009-A</span></div>
        </div>
        <div data-stagger="1" style="position:relative;background:oklch(0.14 0.015 250);padding:36px;opacity:0;transform:translateY(32px);transition:background 0.3s ease,opacity 0.6s ease,transform 0.6s ease" style-hover="background:oklch(0.17 0.02 250)">
          <div style="position:absolute;top:6px;left:6px;width:8px;height:8px;border-top:1px solid oklch(0.5 0.03 250 / 0.6);border-left:1px solid oklch(0.5 0.03 250 / 0.6)"></div>
          <div style="position:absolute;bottom:6px;right:6px;width:8px;height:8px;border-bottom:1px solid oklch(0.5 0.03 250 / 0.6);border-right:1px solid oklch(0.5 0.03 250 / 0.6)"></div>
          <div style="display:flex;justify-content:space-between;align-items:baseline;font-family:'IBM Plex Mono',monospace;font-size:12px;color:oklch(0.5 0.02 85)"><span>010</span><span>HARDWARE</span></div>
          <img src="assets/proj-pc-build.png" alt="PC build in progress: case, motherboards and parts laid out on the floor" style="width:100%;aspect-ratio:16/10;margin-top:16px;border-radius:4px;object-fit:cover;background:oklch(0.2 0.02 250)">
          <div style="margin-top:20px;font-size:21px;font-weight:500;text-wrap:pretty">Personal Computer</div>
          <div style="margin-top:8px;display:flex;align-items:center;gap:5px">
            <div style="width:1px;height:5px;background:oklch(0.5 0.03 250 / 0.6)"></div>
            <div style="width:36px;height:1px;background:oklch(0.5 0.03 250 / 0.6)"></div>
          </div>
          <div style="margin-top:10px;font-size:14px;line-height:1.6;color:oklch(0.72 0.02 85);text-wrap:pretty">PC build that started 2019 and has received upgrades through the years, a PC of Theseus so to say</div>
          <div style="margin-top:16px;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:0.1em;color:oklch(0.45 0.02 85);display:flex;justify-content:space-between;gap:8px"><span>DRWN. IH</span><span>SCALE 1:1</span><span>010-A</span></div>
        </div>
      </div>
      <div style="margin-top:1px;display:flex;flex-wrap:wrap;align-items:center;gap:32px;padding:36px;background:oklch(0.14 0.015 250);border:1px solid oklch(0.4 0.03 250 / 0.3)">
        <img src="assets/valkyrie-avionics-pcb.png" alt="Valkyrie Avionics flight computer PCB render" style="flex:1 1 320px;min-width:min(100%,280px);width:100%;max-width:520px;object-fit:contain;display:block">
        <div style="flex:1 1 260px;min-width:min(100%,240px)">
          <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.15em;color:oklch(0.5 0.14 250)">VALKYRIE AVIONICS</div>
          <div style="margin-top:12px;font-size:19px;font-weight:500;text-wrap:pretty">Flight computers, designed from scratch</div>
          <div style="margin-top:10px;font-size:14px;line-height:1.6;color:oklch(0.72 0.02 85);max-width:44ch;text-wrap:pretty">During my journey making my HPR L1 rocket Valkyrie 1 I experimented tons with PCB design, pictured is one of many boards. This one was the first one made with SMD components and mostly just created for learning purposes and fun. Valkyries real flight computer ran on an RPI 4b connected to peripherals via custom PCB.</div>
        </div>
      </div>
      <a href="https://github.com/ivarhak" target="_blank" rel="noopener" style="margin-top:1px;display:flex;align-items:center;justify-content:center;gap:8px;padding:16px;background:oklch(0.14 0.015 250);border:1px dashed oklch(0.4 0.03 250 / 0.6);font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:0.05em;color:oklch(0.72 0.02 85);transition:border-color 0.3s ease,color 0.3s ease" style-hover="border-color:oklch(0.5 0.14 250);color:oklch(0.58 0.14 250)">MORE FOUND ON GITHUB ↗</a>
    </div>
  </div>

  <div id="contact" data-sec-contact="1" style="position:relative;padding:100px 6vw 120px calc(6vw + 26px);border-top:1px solid oklch(0.4 0.03 250 / 0.3);background:oklch(0.12 0.015 250)">
    <div data-reveal="1" style="opacity:0;transform:translateY(32px);clip-path:inset(0 0 100% 0);transition:opacity 0.7s ease,clip-path 0.8s cubic-bezier(0.65,0,0.35,1),transform 0.7s ease">
      <div style="font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:0.15em;color:oklch(0.5 0.14 250);display:flex;align-items:center;gap:10px">
        04 / CONTACT
        <div style="flex:1;height:1px;background:repeating-linear-gradient(90deg, oklch(0.5 0.03 250 / 0.6) 0 4px, transparent 4px 8px)"></div>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:60px;margin-top:24px">
        <div style="flex:1 1 420px;min-width:min(100%,300px)">
          <div style="font-size:clamp(28px,3.6vw,48px);line-height:1.25;max-width:22ch;font-weight:600;text-wrap:pretty">I'm getting settled at college this year, but always feel free to reach out!</div>
          <div style="margin-top:32px;display:flex;flex-wrap:wrap;gap:22px;font-size:14px;font-family:'IBM Plex Mono',monospace">
            <a href="mailto:ivarhak08@gmail.com" style="color:oklch(0.93 0.015 85);border-bottom:1px solid oklch(0.4 0.03 250 / 0.5)" style-hover="border-color:oklch(0.5 0.14 250);color:oklch(0.58 0.14 250)">EMAIL</a>
            <a href="https://www.linkedin.com/in/ivar-h%C3%A5kansson-250341270" target="_blank" rel="noopener" style="color:oklch(0.93 0.015 85);border-bottom:1px solid oklch(0.4 0.03 250 / 0.5)" style-hover="border-color:oklch(0.5 0.14 250);color:oklch(0.58 0.14 250)">LINKEDIN</a>
            <a href="https://github.com/ivarhak" target="_blank" rel="noopener" style="color:oklch(0.93 0.015 85);border-bottom:1px solid oklch(0.4 0.03 250 / 0.5)" style-hover="border-color:oklch(0.5 0.14 250);color:oklch(0.58 0.14 250)">GITHUB</a>
          </div>
        </div>
      </div>
      <div style="margin-top:100px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;font-size:12px;font-family:'IBM Plex Mono',monospace;color:oklch(0.5 0.02 85)">
        <div>© 2026 IVAR_HAKANSSON</div>
        <div>EARTH, SOL, MILKY WAY GALAXY</div>
        <div>+1 (669) 251-5996</div>
      </div>
    </div>
  </div>

</div>

</x-dc>
<script type="text/x-dc" data-dc-script>
class Component extends DCLogic {
  q(sel) { return (this._host || document).querySelector(sel); }
  qa(sel) { return Array.from((this._host || document).querySelectorAll(sel)); }

  renderVals() {
    return {
      skills: ["Aerospace Engineering", "Mechanical Engineering", "CAD", "PCB Design",
        "Control Systems Design", "3D Printing", "CFD Simulation", "Embedded Systems",
        "Rocketry (TARC/HPR)"],
      timeline: [ // logoH: badge marks read smaller than wordmarks at the same height

        { period: "2026 — 2026", role: "Production & Shipping Associate", org: "FruityChutes", logo: "assets/fruity-chutes-logo.png", logoH: 47,
          note: "Here I was responsible for assembling parachutes and parachute launcher systems as well as performing quality assurance tasks on a wide variety of products." },
        { period: "JUN 2025 — JUN 2026", role: "Club President", org: "Aviation & Rocketry Club — Cupertino HS", logo: "assets/arc-logo.png", logoH: 58,
          note: "4 years of leading one of America's most ambitious high school rocketry teams as well as handling general club duties for aviation enthusiasts at Cupertino High School." },
        { period: "SEP 2023 — SEP 2024", role: "Mechanical & Design Lead", org: "South Bay Robotics (FRC)", logo: "assets/sbr-logo.png", logoH: 47,
          note: "Led both design and mechanical subdivisions for the 2024 season of FRC: Crescendo." },
        { period: "2022 — 2026", role: "TARC Team Captain", org: "Cupertino High School", logo: "assets/tarc-logo.png", logoH: 47,
          note: "Guiding my team's transition into actively controlled rocketry, a journey filled with much challenge but an uncomparable amount of satisfaction." },
      ],
    };
  }

  reveal(sec) {
    const inner = sec.querySelector('[data-reveal]');
    if (inner) { inner.style.opacity = '1'; inner.style.transform = 'translateY(0)'; inner.style.clipPath = 'inset(0% 0 0 0)'; }
    sec.querySelectorAll('[data-stagger]').forEach((el, i) => {
      const delay = i * 70;
      el.style.transitionDelay = delay + 'ms';
      el.style.opacity = '1';
      el.style.transform = 'translateY(0)';
      // Clear the entry delay afterwards, or later cards inherit it on hover.
      setTimeout(() => { el.style.transitionDelay = '0ms'; }, delay + 700);
    });
  }

  revealAll() { this.qa('[data-sec-about],[data-sec-exp],[data-sec-work],[data-sec-contact]').forEach(s => this.reveal(s)); }

  // src is assigned here, not in the template: a {{ hole }} in src fires a 404 for the literal path.
  applyLogoSrcs() {
    this.qa('[data-logo-src]').forEach(el => {
      const s = el.getAttribute('data-logo-src');
      if (s && s.indexOf('{{') < 0 && el.getAttribute('src') !== s) el.setAttribute('src', s);
    });
  }

  componentDidUpdate() { this.applyLogoSrcs(); }

  componentDidMount() {
    const root = this.q('[data-root]');
    this.applyLogoSrcs();
    this._host = root ? root.getRootNode() : document;

    // Fail-open: if the observer or boot never runs, the page must still be readable.
    this._failOpen = setTimeout(() => {
      const b = this.q('[data-boot]');
      if (b && b.style.display !== 'none') b.style.display = 'none';
      this.revealAll();
    }, 6000);

    let pct = 0;
    this._iv = setInterval(() => {
      pct = Math.min(100, pct + 4 + Math.random() * 9);
      const fill = this.q('[data-boot-fill]'), lbl = this.q('[data-boot-pct]');
      if (fill) fill.style.width = pct + '%';
      if (lbl) lbl.textContent = Math.round(pct) + '%';
      if (pct >= 100) {
        clearInterval(this._iv);
        setTimeout(() => {
          const l = this.q('[data-boot-left]'), r = this.q('[data-boot-right]'), c = this.q('[data-boot-content]');
          if (l) l.style.transform = 'translateX(-100%)';
          if (r) r.style.transform = 'translateX(100%)';
          if (c) c.style.opacity = '0';
          setTimeout(() => { const b = this.q('[data-boot]'); if (b) b.style.display = 'none'; }, 1300);
        }, 350);
      }
    }, 60);

    this.qa('[data-autoplay-video]').forEach(v => {
      const silence = () => {
        v.muted = true; v.defaultMuted = true; v.volume = 0;
        v.setAttribute('muted', '');
        // Some sources carry multiple audio tracks; disable each one outright.
        if (v.audioTracks) for (let i = 0; i < v.audioTracks.length; i++) v.audioTracks[i].enabled = false;
      };
      silence();
      v.loop = true; v.playsInline = true;
      // Some browsers restore volume/unmute on play or source switch — re-assert every time.
      ['volumechange', 'play', 'playing', 'loadeddata', 'loadedmetadata', 'canplay'].forEach(ev =>
        v.addEventListener(ev, silence));
      const go = () => { silence(); v.play().catch(() => {}); };
      v._playWhenVisible = go;
      go();
      v.addEventListener('canplay', go, { once: true });
    });

    // Browsers pause far-offscreen media; resume on visibility instead of relying on one play() at mount.
    const vids = this.qa('[data-autoplay-video]');
    if (vids.length) {
      this._vidIo = new IntersectionObserver((entries) => {
        entries.forEach(en => {
          const v = en.target;
          if (en.isIntersecting) { if (v._playWhenVisible) v._playWhenVisible(); }
          else if (!v.paused) v.pause();
        });
      }, { rootMargin: '200px 0px', threshold: 0.01 });
      vids.forEach(v => this._vidIo.observe(v));
    }

    const cursor = this.q('[data-cursor]');
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches && root && cursor) {
      root.style.cursor = 'none';
      const ring = this.q('[data-cursor-ring]');
      this._move = (e) => { cursor.style.opacity = '1'; cursor.style.left = e.clientX + 'px'; cursor.style.top = e.clientY + 'px'; };
      this._over = (e) => {
        const on = !!(e.target.closest && e.target.closest('a,button,input,textarea'));
        cursor.style.width = on ? '46px' : '22px';
        cursor.style.height = on ? '46px' : '22px';
        cursor.style.marginLeft = on ? '-23px' : '-11px';
        cursor.style.marginTop = on ? '-23px' : '-11px';
        cursor.style.transform = on ? 'rotate(45deg)' : 'rotate(0deg)';
        if (ring) ring.style.borderRadius = on ? '23px' : '0';
      };
      window.addEventListener('mousemove', this._move);
      window.addEventListener('mouseover', this._over);
    }

    const scroller = root && root.closest ? (root.closest('[data-scroll-container]') || null) : null;
    this._scroll = () => {
      const doc = document.documentElement;
      const y = scroller ? scroller.scrollTop : (window.scrollY || doc.scrollTop);
      const max = (scroller ? scroller.scrollHeight - scroller.clientHeight : doc.scrollHeight - window.innerHeight);
      const label = Math.round((max > 0 ? Math.max(0, Math.min(1, y / max)) : 0) * 100);
      const nav = this.q('[data-nav]'), rl = this.q('[data-ruler-label]'), rd = this.q('[data-ruler-dot]');
      if (nav) nav.style.background = y > 40 ? 'oklch(0.14 0.015 250 / 0.9)' : 'oklch(0.14 0.015 250 / 0)';
      if (rl) rl.textContent = `SCROLL ${label}%`;
      if (rd) rd.style.top = label + '%';
    };
    window.addEventListener('scroll', this._scroll, true);
    this._scroll();

    const secs = this.qa('[data-sec-about],[data-sec-exp],[data-sec-work],[data-sec-contact]');
    if (!secs.length) { this.revealAll(); return; }
    this._io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        this.reveal(en.target);
        this._io.unobserve(en.target);
      });
    }, { threshold: 0.12 });
    secs.forEach(s => this._io.observe(s));
  }

  componentWillUnmount() {
    clearInterval(this._iv);
    clearTimeout(this._failOpen);
    window.removeEventListener('scroll', this._scroll, true);
    if (this._move) window.removeEventListener('mousemove', this._move);
    if (this._over) window.removeEventListener('mouseover', this._over);
    if (this._io) this._io.disconnect();
    if (this._vidIo) this._vidIo.disconnect();
  }
}
</script>
</body>
</html>
