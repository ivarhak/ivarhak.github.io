<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Ivar Hakansson — Mechanical &amp; Aerospace Engineer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&amp;family=IBM+Plex+Sans:wght@300;400;500;600&amp;display=swap" rel="stylesheet">
<style>
  body { margin: 0; background: oklch(0.14 0.015 250); color: oklch(0.93 0.015 85); font-family: 'IBM Plex Sans', sans-serif; }
  html { scroll-behavior: smooth; }
  a { color: oklch(0.93 0.015 85); text-decoration: none; }
  a:hover { color: oklch(0.58 0.14 250); }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes blink { 50% { opacity: 0; } }
</style>
</helmet>

<div data-boot="1" style="position:fixed;inset:0;z-index:10000;pointer-events:none">
  <div data-boot-left="1" style="position:absolute;top:0;left:0;width:50%;height:100%;background:oklch(0.14 0.015 250);background-image:linear-gradient(oklch(0.32 0.02 250 / 0.4) 1px, transparent 1px),linear-gradient(90deg, oklch(0.32 0.02 250 / 0.4) 1px, transparent 1px);background-size:64px 64px;border-right:1px solid oklch(0.5 0.14 250 / 0.4);transition:transform 1s cubic-bezier(0.76,0,0.24,1) 0.15s"></div>
  <div data-boot-right="1" style="position:absolute;top:0;right:0;width:50%;height:100%;background:oklch(0.14 0.015 250);background-image:linear-gradient(oklch(0.32 0.02 250 / 0.4) 1px, transparent 1px),linear-gradient(90deg, oklch(0.32 0.02 250 / 0.4) 1px, transparent 1px);background-size:64px 64px;border-left:1px solid oklch(0.5 0.14 250 / 0.4);transition:transform 1s cubic-bezier(0.76,0,0.24,1) 0.15s"></div>
  <div data-boot-content="1" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);display:flex;flex-direction:column;align-items:center;gap:22px;transition:opacity 0.35s ease">
    <div style="position:relative;width:96px;height:96px">
      <div style="position:absolute;inset:0;border-radius:50%;border:1px dashed oklch(0.5 0.03 250 / 0.7);animation:spin 6s linear infinite"></div>
      <div style="position:absolute;inset:14px;border-radius:50%;border:1px solid oklch(0.5 0.14 250 / 0.6)"></div>
      <div style="position:absolute;top:50%;left:6px;right:6px;height:1px;background:oklch(0.5 0.14 250 / 0.5);transform:translateY(-50%)"></div>
      <div style="position:absolute;left:50%;top:6px;bottom:6px;width:1px;background:oklch(0.5 0.14 250 / 0.5);transform:translateX(-50%)"></div>
    </div>
    <div style="font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:0.2em;color:oklch(0.6 0.02 85)">INITIALIZING SYSTEM<span style="animation:blink 1.1s step-start infinite">_</span></div>
    <div style="width:220px;height:2px;background:oklch(0.4 0.03 250 / 0.4);position:relative">
      <div data-boot-fill="1" style="position:absolute;left:0;top:0;height:100%;width:0%;background:oklch(0.5 0.14 250);transition:width 0.15s linear"></div>
    </div>
    <div data-boot-pct="1" style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:oklch(0.5 0.14 250)">0%</div>
  </div>
</div>

<div data-cursor="1" style="position:fixed;left:0;top:0;width:22px;height:22px;margin-left:-11px;margin-top:-11px;pointer-events:none;z-index:9999;opacity:0;transition:width 0.25s cubic-bezier(0.2,0.8,0.2,1),height 0.25s cubic-bezier(0.2,0.8,0.2,1),margin 0.25s cubic-bezier(0.2,0.8,0.2,1),transform 0.35s cubic-bezier(0.2,0.8,0.2,1)">
  <div data-cursor-ring="1" style="position:absolute;inset:0;border:1px solid oklch(0.5 0.14 250);border-radius:0;transition:border-radius 0.25s"></div>
  <div style="position:absolute;top:50%;left:50%;width:3px;height:3px;margin-left:-1.5px;margin-top:-1.5px;border-radius:50%;background:oklch(0.5 0.14 250)"></div>
  <div style="position:absolute;top:-6px;left:50%;width:1px;height:5px;transform:translateX(-50%);background:oklch(0.5 0.14 250)"></div>
  <div style="position:absolute;bottom:-6px;left:50%;width:1px;height:5px;transform:translateX(-50%);background:oklch(0.5 0.14 250)"></div>
  <div style="position:absolute;left:-6px;top:50%;width:5px;height:1px;transform:translateY(-50%);background:oklch(0.5 0.14 250)"></div>
  <div style="position:absolute;right:-6px;top:50%;width:5px;height:1px;transform:translateY(-50%);background:oklch(0.5 0.14 250)"></div>
</div>

<div data-root="1" style="position:relative;min-height:100vh;overflow-x:hidden;background-image:linear-gradient(oklch(0.32 0.02 250 / 0.4) 1px, transparent 1px),linear-gradient(90deg, oklch(0.32 0.02 250 / 0.4) 1px, transparent 1px);background-size:64px 64px">

  <div style="position:fixed;left:0;top:0;bottom:0;width:26px;z-index:150;border-right:1px solid oklch(0.4 0.03 250 / 0.5);display:flex;flex-direction:column;align-items:center;padding:16px 0">
    <div data-ruler-label="1" style="font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:0.2em;color:oklch(0.5 0.02 85);writing-mode:vertical-rl;transform:rotate(180deg)">SCROLL 0%</div>
    <div style="position:relative;flex:1;width:1px;background:oklch(0.4 0.03 250 / 0.5);margin-top:14px">
      <div data-ruler-dot="1" style="position:absolute;left:50%;top:0%;width:9px;height:9px;margin-left:-4px;margin-top:-4px;border-radius:50%;background:oklch(0.5 0.14 250);box-shadow:0 0 8px oklch(0.5 0.14 250 / 0.7);transition:top 0.05s linear"></div>
    </div>
  </div>

  <div style="position:fixed;top:0;left:26px;right:0;z-index:110;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:8px;padding:8px 6vw;background:oklch(0.11 0.015 250);border-bottom:1px solid oklch(0.4 0.03 250 / 0.3);font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.08em">
    <div style="display:flex;align-items:center;gap:8px;color:oklch(0.5 0.14 250)">
      <div style="width:6px;height:6px;border-radius:50%;background:oklch(0.62 0.16 150)"></div>
      STATUS: STARTING COLLEGE — UP FOR PROJECT WORK
    </div>
    <div style="display:flex;gap:20px;color:oklch(0.78 0.02 85)">
      <a href="https://github.com/ivarhak" target="_blank" rel="noopener" style="color:inherit" style-hover="color:oklch(0.5 0.14 250)">GITHUB ↗</a>
      <a href="https://www.linkedin.com/in/ivar-h%C3%A5kansson-250341270" target="_blank" rel="noopener" style="color:inherit" style-hover="color:oklch(0.5 0.14 250)">LINKEDIN ↗</a>
      <a href="mailto:ivarhak08@gmail.com" style="color:inherit" style-hover="color:oklch(0.5 0.14 250)">EMAIL ↗</a>
    </div>
  </div>

  <div data-nav="1" style="position:fixed;top:34px;left:26px;right:0;z-index:100;display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;align-items:center;padding:22px 6vw;backdrop-filter:blur(10px);background:oklch(0.14 0.015 250 / 0);border-bottom:1px solid oklch(0.4 0.03 250 / 0.3);transition:background 0.2s ease">
    <div style="font-family:'IBM Plex Mono',monospace;font-size:15px;letter-spacing:0.02em;display:flex;align-items:center;gap:10px"><span style="color: oklch(0.5 0.14 250);">//</span> IVAR_HAAKANSSON.ME</div>
    <div style="display:flex;flex-wrap:wrap;gap:32px;font-size:13px;font-family:'IBM Plex Mono',monospace;letter-spacing:0.03em">
      <a href="#about" style="color:oklch(0.78 0.02 85)" style-hover="color:oklch(0.5 0.14 250)">01_ABOUT</a>
      <a href="#experience" style="color:oklch(0.78 0.02 85)" style-hover="color:oklch(0.5 0.14 250)">02_EXPERIENCE</a>
      <a href="#work" style="color:oklch(0.78 0.02 85)" style-hover="color:oklch(0.5 0.14 250)">03_PROJECTS</a>
      <a href="#contact" style="color:oklch(0.78 0.02 85)" style-hover="color:oklch(0.5 0.14 250)">04_CONTACT</a>
    </div>
  </div>

  <div style="display:flex;flex-wrap:wrap-reverse;align-items:center;gap:48px;padding:126px 6vw 44px calc(6vw + 26px)">
    <div style="flex:1 1 420px;min-width:min(100%,300px)">
      <div style="opacity:0;animation:fadeUp 0.8s ease 0.1s both;font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:0.15em;color:oklch(0.5 0.14 250)">[ MECHANICAL &amp; AEROSPACE ENGINEER ]</div>
      <div style="opacity:0;animation:fadeUp 0.9s ease 0.25s both;font-weight:600;font-size:clamp(36px,5.4vw,80px);line-height:1.15;margin-top:16px;max-width:20ch;text-wrap:pretty">"The greatest scientists are artists as well." <span style="color:oklch(0.6 0.02 85);font-size:0.5em">— Einstein</span></div>

      <div style="opacity:0;animation:fadeUp 0.9s ease 0.35s both;margin-top:22px;display:flex;align-items:center;gap:8px">
        <div style="width:8px;height:8px;border-left:1px solid oklch(0.5 0.03 250 / 0.7);border-bottom:1px solid oklch(0.5 0.03 250 / 0.7)"></div>
        <div style="width:340px;max-width:30vw;height:1px;background:oklch(0.5 0.03 250 / 0.7)"></div>
        <div style="width:8px;height:8px;border-right:1px solid oklch(0.5 0.03 250 / 0.7);border-bottom:1px solid oklch(0.5 0.03 250 / 0.7)"></div>
        <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.1em;color:oklch(0.5 0.02 85);white-space:nowrap">TOLERANCE: ±0.0 DEVIATION</div>
      </div>

      <div style="opacity:0;animation:fadeUp 0.9s ease 0.45s both;margin-top:22px;max-width:56ch;font-size:18px;line-height:1.65;color:oklch(0.78 0.02 85);text-wrap:pretty">
        Hi, I'm Ivar and welcome to my portfolio website, here you'll find details on the work I've done and see some projects I'm most proud of. I'm Swedish to begin with but I was raised in Cupertino, California, the heart of Silicon Valley. More than anything, living in such an area taught me the power of learning hands on and the strength of tackling challenges as a group, so if you have any projects that need another set of eyes, let me know, I'd love to get some work done!
      </div>

      <div style="opacity:0;animation:fadeUp 0.9s ease 0.6s both;margin-top:40px;display:flex;flex-wrap:wrap;gap:16px">
        <a href="#experience" style="padding:15px 30px;font-family:'IBM Plex Mono',monospace;font-size:14px;border:1px solid oklch(0.4 0.03 250 / 0.5);color:oklch(0.93 0.015 85);transition:transform 0.3s ease,border-color 0.3s ease" style-hover="transform:translateY(-3px);border-color:oklch(0.5 0.14 250);color:oklch(0.93 0.015 85)">VIEW_EXPERIENCE &rarr;</a>
        <a href="#work" style="padding:15px 30px;font-family:'IBM Plex Mono',monospace;font-size:14px;background:oklch(0.5 0.14 250);color:oklch(0.97 0.01 85);font-weight:500;border:none;transition:transform 0.3s ease,background 0.3s ease" style-hover="transform:translateY(-3px);background:oklch(0.58 0.14 250);color:oklch(0.97 0.01 85)">VIEW_PROJECTS →</a>
        <a href="#contact" style="padding:15px 30px;font-family:'IBM Plex Mono',monospace;font-size:14px;border:1px solid oklch(0.4 0.03 250 / 0.5);color:oklch(0.93 0.015 85);transition:transform 0.3s ease,border-color 0.3s ease" style-hover="transform:translateY(-3px);border-color:oklch(0.5 0.14 250);color:oklch(0.93 0.015 85)">CONTACT →</a>
      </div>

      <div style="opacity:0;animation:fadeUp 0.9s ease 0.7s both;margin-top:14px;display:flex;align-items:center;gap:6px">
        <div style="width:1px;height:6px;background:oklch(0.5 0.03 250 / 0.6)"></div>
        <div style="width:158px;height:1px;background:oklch(0.5 0.03 250 / 0.6)"></div>
        <div style="width:1px;height:6px;background:oklch(0.5 0.03 250 / 0.6)"></div>
        <div style="font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:0.1em;color:oklch(0.45 0.02 85);white-space:nowrap">ACTIONS ×3</div>
      </div>
    </div>

    <div style="flex:0 0 auto;display:flex;flex-direction:column;align-items:center;gap:12px">
      <div style="position:relative;width:clamp(240px,28vw,380px);aspect-ratio:1;border:1px solid oklch(0.4 0.03 250 / 0.5)">
        <div style="position:absolute;top:-1px;left:-1px;width:16px;height:16px;border-top:2px solid oklch(0.5 0.14 250);border-left:2px solid oklch(0.5 0.14 250)"></div>
        <div style="position:absolute;bottom:-1px;right:-1px;width:16px;height:16px;border-bottom:2px solid oklch(0.5 0.14 250);border-right:2px solid oklch(0.5 0.14 250)"></div>
        <div style="position:absolute;inset:8%;border-radius:50%;overflow:hidden;background:oklch(0.17 0.02 250)">
          <img src="assets/profile-photo.jpg" alt="Ivar Hakansson" style="width:100%;height:100%;object-fit:cover;filter:grayscale(0.15) contrast(1.05)">
        </div>
        <div style="position:absolute;inset:8%;border-radius:50%;border:1px dashed oklch(0.5 0.03 250 / 0.6);pointer-events:none"></div>
      </div>
    </div>
  </div>

  <div id="about" data-sec-about="1" style="position:relative;padding:80px 6vw 80px calc(6vw + 26px);border-top:1px solid oklch(0.4 0.03 250 / 0.3)">
    <div style="position:absolute;top:-1px;left:calc(6vw + 26px);width:10px;height:10px;border-top:2px solid oklch(0.5 0.14 250);border-left:2px solid oklch(0.5 0.14 250)"></div>
    <div style="position:absolute;bottom:0;right:6vw;width:10px;height:10px;border-bottom:2px solid oklch(0.5 0.14 250);border-right:2px solid oklch(0.5 0.14 250)"></div>
    <div data-reveal="1" style="opacity:0;transform:translateY(32px);clip-path:inset(0 0 100% 0);transition:opacity 0.7s ease,clip-path 0.8s cubic-bezier(0.65,0,0.35,1),transform 0.7s ease;display:flex;flex-wrap:wrap;gap:60px">
      <div style="flex:0 0 220px;max-width:100%">
        <div style="font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:0.15em;color:oklch(0.5 0.14 250);display:flex;align-items:center;gap:10px">
          01 / ABOUT
          <div style="flex:1;height:1px;background:repeating-linear-gradient(90deg, oklch(0.5 0.03 250 / 0.6) 0 4px, transparent 4px 8px)"></div>
        </div>
      </div>
      <div style="flex:1 1 460px;min-width:min(100%,300px)">
        <div style="font-size:clamp(26px,3vw,38px);line-height:1.4;max-width:28ch;font-weight:500;text-wrap:pretty">"Our greatest glory is not in never failing, but in rising every time we fail." <span style="color:oklch(0.6 0.02 85);font-size:0.6em">— Confucius</span></div>
        <p style="margin:32px 0 0;font-size:16px;line-height:1.75;color:oklch(0.72 0.02 85);max-width:60ch;text-wrap:pretty">Working in engineering has always been the dream because I love working at the cutting edge of technology. Its a love/hate the feeling when you finish a long project just to find that the sensors in it are already a generation old by now. Plus it's always nice to be able to say “It's only rocket science” when people ask about your projects.</p>
        <p style="margin:20px 0 0;font-size:16px;line-height:1.75;color:oklch(0.72 0.02 85);max-width:60ch;text-wrap:pretty">
          However everything isn't always cupcakes and rainbows when working on this sort of projects, so it's very important to be able to bounce back after a failure. Like when my school's TARC rocket absolutely lawn darted straight into a river and had its entire flight computer and tubing destroyed on impact. But believe it or not, with some backup parts and late night construction (and some top notch leadership&nbsp;;) ) we were back at it the next week.
        </p>
        <div style="margin-top:28px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:16px;max-width:60ch">
          <figure style="margin:0">
            <img src="assets/tarc-river.jpg" alt="TARC rocket recovered from a river after a lawn dart" style="width:100%;aspect-ratio:4/3;object-fit:cover;border:1px solid oklch(0.4 0.03 250 / 0.5);display:block">
            <figcaption style="margin-top:8px;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:0.1em;color:oklch(0.6 0.02 85)">A METER OFF FROM CATASTROPHE</figcaption>
          </figure>
          <figure style="margin:0">
            <img src="assets/valkyrie-build.jpg" alt="Valkyrie 1 assembled in the workshop" style="width:100%;aspect-ratio:4/3;object-fit:cover;border:1px solid oklch(0.4 0.03 250 / 0.5);display:block">
            <figcaption style="margin-top:8px;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:0.1em;color:oklch(0.6 0.02 85)">VALKYRIE 1 — HPR CAPABLE OF 2KM+</figcaption>
          </figure>
        </div>
        <p style="margin:20px 0 0;font-size:16px;line-height:1.75;color:oklch(0.72 0.02 85);max-width:60ch;text-wrap:pretty">My 4 years at Cupertino High School I led my team's shift from dumb unguided and gruelingly manufactured rockets to smart actively controlled rockets. Starting at CHS no one on the team knew how to even assemble a rocket motor but by my 3rd year, under my leadership we made everything from custom flight computer PCBs to functional airbrake systems capable of steering our rocket to an apogee with an accuracy in centimeters. Best part of it all though has to be all the people I met along the way, all the folks I mentored, and the impact made on the generation that came after me, creating a base for them to build on.</p>
        <p style="margin:20px 0 0;font-size:16px;line-height:1.75;color:oklch(0.72 0.02 85);max-width:60ch;text-wrap:pretty">
          But I do more than just high school rocketry! I also have work experience at FruityChutes, a Silicon Valley parachute manufacturer specializing in parachutes and launchers for rocketry and UAV platforms (drones, robotaxis, fixed wing craft, that sort of thing). At FruityChutes I was responsible for assembling parachutes and parachute launcher systems as well as performing quality assurance tasks on a wide variety of products.
        </p>
        <div style="margin-top:36px;display:flex;align-items:center;gap:6px">
          <div style="width:1px;height:6px;background:oklch(0.5 0.03 250 / 0.6)"></div>
          <div style="width:220px;max-width:30vw;height:1px;background:oklch(0.5 0.03 250 / 0.6)"></div>
          <div style="width:1px;height:6px;background:oklch(0.5 0.03 250 / 0.6)"></div>
          <div style="font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:0.1em;color:oklch(0.45 0.02 85);white-space:nowrap">COMPETENCY MATRIX — 9 ITEMS</div>
        </div>
        <div style="margin-top:16px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,170px),1fr));gap:1px;background:oklch(0.4 0.03 250 / 0.3);border:1px solid oklch(0.4 0.03 250 / 0.3)">
          <sc-for list="{{ skills }}" as="skill" hint-placeholder-count="9">
            <div data-stagger="1" style="padding:16px;background:oklch(0.14 0.015 250);font-family:'IBM Plex Mono',monospace;font-size:13px;color:oklch(0.85 0.015 85);opacity:0;transform:translateY(32px);transition:background 0.3s ease,color 0.3s ease,opacity 0.6s ease,transform 0.6s ease" style-hover="background:oklch(0.5 0.14 250 / 0.15);color:oklch(0.58 0.14 250)">{{ skill }}</div>
          </sc-for>
        </div>
      </div>
    </div>
  </div>

  <div style="position:relative;border-top:1px solid oklch(0.4 0.03 250 / 0.3);margin-left:26px">
    <img src="assets/photon-exploded.png" alt="Photon exploded assembly view" style="width:100%;aspect-ratio:64/17;object-fit:cover;object-position:center;display:block;background:oklch(0.14 0.015 250)">
    <div style="position:absolute;left:6vw;bottom:18px;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:0.16em;color:oklch(0.6 0.02 85)">PHOTON — EXPLODED ASSEMBLY VIEW (SENIOR YEAR TARC ROCKET)</div>
  </div>

  <div id="experience" data-sec-exp="1" style="position:relative;padding:40px 6vw 70px calc(6vw + 26px);border-top:1px solid oklch(0.4 0.03 250 / 0.3)">
    <div data-reveal="1" style="opacity:0;transform:translateY(32px);clip-path:inset(0 0 100% 0);transition:opacity 0.7s ease,clip-path 0.8s cubic-bezier(0.65,0,0.35,1),transform 0.7s ease">
      <div style="font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:0.15em;color:oklch(0.5 0.14 250);display:flex;align-items:center;gap:10px">
        02 / LOG
        <div style="flex:1;height:1px;background:repeating-linear-gradient(90deg, oklch(0.5 0.03 250 / 0.6) 0 4px, transparent 4px 8px)"></div>
      </div>
      <div style="position:relative;padding-left:28px;margin-top:50px">
        <div style="position:absolute;left:4px;top:6px;bottom:6px;width:1px;background:oklch(0.4 0.03 250 / 0.5)"></div>
        <sc-for list="{{ timeline }}" as="item" hint-placeholder-count="4">
          <div data-stagger="1" style="position:relative;padding-bottom:44px;opacity:0;transform:translateY(32px);transition:opacity 0.6s ease,transform 0.6s ease">
            <div style="position:absolute;left:-28px;top:4px;width:9px;height:9px;border-radius:50%;background:oklch(0.5 0.14 250);box-shadow:0 0 0 4px oklch(0.5 0.14 250 / 0.15)"></div>
            <div style="font-family:'IBM Plex Mono',monospace;font-size:13px;color:oklch(0.6 0.02 85)">{{ item.period }}</div>
            <div style="margin-top:8px;display:flex;align-items:center;gap:18px;flex-wrap:wrap">
              <div>
                <div style="font-size:19px;font-weight:500">{{ item.role }}</div>
                <div style="margin-top:4px;font-size:15px;color:oklch(0.72 0.02 85)">{{ item.org }}</div>
              </div>
              <sc-if value="{{ item.logo }}" hint-placeholder-val="{{ false }}">
                <img data-logo-src="{{ item.logo }}" alt="{{ item.org }}" height="{{ item.logoH }}" style="width:auto;display:block">
              </sc-if>
            </div>
            <div style="margin-top:8px;font-size:14px;line-height:1.6;color:oklch(0.6 0.02 85);max-width:62ch;text-wrap:pretty">{{ item.note }}</div>
          </div>
        </sc-for>
      </div>
    </div>
  </div>

  <div id="work" data-sec-work="1" style="position:relative;padding:40px 6vw 80px calc(6vw + 26px);border-top:1px solid oklch(0.4 0.03 250 / 0.3)">
    <div data-reveal="1" style="opacity:0;transform:translateY(32px);clip-path:inset(0 0 100% 0);transition:opacity 0.7s ease,clip-path 0.8s cubic-bezier(0.65,0,0.35,1),transform 0.7s ease">
      <div style="font-family:'IBM Plex Mono',monospace;font-size:13px;letter-spacing:0.15em;color:oklch(0.5 0.14 250);display:flex;align-items:center;gap:10px">
        03 / SELECTED WORK
        <div style="flex:1;height:1px;background:repeating-linear-gradient(90deg, oklch(0.5 0.03 250 / 0.6) 0 4px, transparent 4px 8px)"></div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:1px;background:oklch(0.4 0.03 250 / 0.3);border:1px solid oklch(0.4 0.03 250 / 0.3);margin-top:50px">
        <div data-stagger="1" style="position:relative;background:oklch(0.14 0.015 250);padding:36px;opacity:0;transform:translateY(32px);transition:background 0.3s ease,opacity 0.6s ease,transform 0.6s ease" style-hover="background:oklch(0.17 0.02 250)">
          <div style="position:absolute;top:6px;left:6px;width:8px;height:8px;border-top:1px solid oklch(0.5 0.03 250 / 0.6);border-left:1px solid oklch(0.5 0.03 250 / 0.6)"></div>
          <div style="position:absolute;bottom:6px;right:6px;width:8px;height:8px;border-bottom:1px solid oklch(0.5 0.03 250 / 0.6);border-right:1px solid oklch(0.5 0.03 250 / 0.6)"></div>
          <div style="display:flex;justify-content:space-between;align-items:baseline;font-family:'IBM Plex Mono',monospace;font-size:12px;color:oklch(0.5 0.02 85)"><span>001</span><span>SIMULATION</span></div>
          <video data-autoplay-video="1" src="https://ivarhak.github.io/assets/wind-tunnel-clip.webm" poster="assets/wind-tunnel-frame.png" loop="1" muted="1" defaultMuted="1" playsInline="1" preload="metadata" style="width:100%;aspect-ratio:16/10;margin-top:16px;border-radius:4px;object-fit:cover;background:oklch(0.2 0.02 250);display:block"></video>
          <div style="margin-top:20px;font-size:21px;font-weight:500;text-wrap:pretty">Local Run 2D Wind Tunnel Simulator</div>
          <div style="margin-top:8px;display:flex;align-items:center;gap:5px">
            <div style="width:1px;height:5px;background:oklch(0.5 0.03 250 / 0.6)"></div>
            <div style="width:36px;height:1px;background:oklch(0.5 0.03 250 / 0.6)"></div>
          </div>
          <div style="margin-top:10px;font-size:14px;line-height:1.6;color:oklch(0.72 0.02 85);text-wrap:pretty">Built after finding available fluid-sim tools either paywalled or overkill. A from-scratch 2D flow solver visualizing wake separation and airflow over arbitrary profiles at low Reynolds number flow.</div>
          <a href="https://github.com/ivarhak/simple2Dwindtunnel" target="_blank" rel="noopener" style="margin-top:14px;display:inline-block;font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.08em;color:oklch(0.58 0.14 250);border-bottom:1px solid oklch(0.4 0.03 250 / 0.5)" style-hover="border-color:oklch(0.5 0.14 250)">VIEW ON GITHUB ↗</a>
          <div style="margin-top:16px;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:0.1em;color:oklch(0.45 0.02 85);display:flex;justify-content:space-between;gap:8px"><span>DRWN. IH</span><span>SCALE 1:1</span><span>001-A</span></div>
        </div>
        <div data-stagger="1" style="position:relative;background:oklch(0.14 0.015 250);padding:36px;opacity:0;transform:translateY(32px);transition:background 0.3s ease,opacity 0.6s ease,transform 0.6s ease" style-hover="background:oklch(0.17 0.02 250)">
          <div style="position:absolute;top:6px;left:6px;width:8px;height:8px;border-top:1px solid oklch(0.5 0.03 250 / 0.6);border-left:1px solid oklch(0.5 0.03 250 / 0.6)"></div>
          <div style="position:absolute;bottom:6px;right:6px;width:8px;height:8px;border-bottom:1px solid oklch(0.5 0.03 250 / 0.6);border-right:1px solid oklch(0.5 0.03 250 / 0.6)"></div>
          <div style="display:flex;justify-content:space-between;align-items:baseline;font-family:'IBM Plex Mono',monospace;font-size:12px;color:oklch(0.5 0.02 85)"><span>002</span><span>ROCKETRY</span></div>
          <video data-autoplay-video="1" src="https://ivarhak.github.io/assets/valkyrie-deploy.mp4" loop="1" muted="1" defaultMuted="1" playsInline="1" preload="metadata" style="width:100%;aspect-ratio:16/10;margin-top:16px;border-radius:4px;object-fit:cover;background:oklch(0.2 0.02 250);display:block"></video>
          <div style="margin-top:20px;font-size:21px;font-weight:500;text-wrap:pretty">The Valkyrie Project</div>
          <div style="margin-top:8px;display:flex;align-items:center;gap:5px">
            <div style="width:1px;height:5px;background:oklch(0.5 0.03 250 / 0.6)"></div>
            <div style="width:36px;height:1px;background:oklch(0.5 0.03 250 / 0.6)"></div>
          </div>
          <div style="margin-top:10px;font-size:14px;line-height:1.6;color:oklch(0.72 0.02 85);text-wrap:pretty">High-power rocket based project series intended to help me learn the ins and outs of rocket design, manufacturing, and PCB design from the ground up.</div>
          <div style="margin-top:16px;font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:0.1em;color:oklch(0.45 0.02 85);display:flex;justify-content:space-between;gap:8px"><span>DRWN. IH</span><span>SCALE 1:1</span><span>002-A</span></div>
        </div>
        <div data-stagger="1" style="position:relative;background:oklch(0.14 0.015 250);padding:36px;opacity:0;transform:translateY(32px);transition:background 0.3s ease,opacity 0.6s ease,transform 0.6s ease" style-hover="background:oklch(0.17 0.02 250)">
          <div style="position:absolute;top:6px;left:6px;width:8px;height:8px;border-top:1px solid oklch(0.5 0.03 250 / 0.6);border-left:1px solid oklch(0.5 0.03 250 / 0.6)"></div>
          <div style="position:absolute;bottom:6px;right:6px;width:8px;height:8px;border-bottom:1px solid oklch(0.5 0.03 250 / 0.6);border-right:1px solid oklch(0.5 0.03 250 / 0.6)"></div>
          <div style="display:flex;justify-content:space-between;align-items:baseline;font-family:'IBM Plex Mono',monospace;font-size:12px;color:oklch(0.5 0.02 85)"><span>003</span><span>SOFTWARE</span></div>
          <img src="assets/proj-plugin.png" alt="OpenRocket Airbrake Simulation Plugin" style="width:100%;aspect-ratio:16/10;margin-top:16px;border-radius:4px;object-fit:cover;background:oklch(0.2 0.02 250)">
          <div style="margin-top:20px;font-size:21px;font-weight:500;text-wrap:pretty">OpenRocket Airbrake Simulation Plugin</div>
          <div style="margin-top:8px;display:flex;align-items:center;gap:5px">
